FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY App.tsx index.ts app.json app.config.js tsconfig.json ./
COPY src ./src
COPY public ./public
COPY assets ./assets
ARG EXPO_PUBLIC_API_URL=/api
ARG EXPO_PUBLIC_FIREBASE_API_KEY
ARG EXPO_PUBLIC_FIREBASE_PROJECT_ID
ARG EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
ARG EXPO_PUBLIC_FIREBASE_APP_ID
ARG EXPO_PUBLIC_FIREBASE_VAPID_KEY
RUN EXPO_OFFLINE=1 npm run build:web

FROM nginx:1.28-alpine
ENV CARTIQ_HTTPS_ORIGIN=https://localhost:8443
ENV NGINX_ENVSUBST_FILTER=^CARTIQ_HTTPS_ORIGIN$
COPY configuration/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
