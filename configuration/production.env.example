ALLOWED_ORIGINS=https://localhost:8443
HTTPS_BIND=127.0.0.1
HTTPS_PORT=8443
HTTP_REDIRECT_PORT=8081
CARTIQ_HTTPS_ORIGIN=https://localhost:8443
CARTIQ_TLS_DIR=./configuration/tls
DB_USERNAME=cartiq
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
AI_SERVICE_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# For a deployed database, supply a MySQL URL with certificate verification and dedicated users.
# DB_URL=jdbc:mysql://db.example.invalid:3306/cartiq?sslMode=VERIFY_IDENTITY&connectionTimeZone=UTC
# MIGRATION_DB_USERNAME=
# MIGRATION_DB_PASSWORD=
# Public OSMF pilot option for a single backend: https://nominatim.openstreetmap.org
# Supply a monitored operator email and approve any non-personal reverse lookup point.
CARTIQ_GEOCODER_URL=
CARTIQ_GEOCODER_CONTACT=
CARTIQ_GEOCODER_PUBLIC_REVERSE_POINT=
# Enable precise device GPS only for a private provider authorized to receive it.
CARTIQ_GEOCODER_ALLOW_DEVICE_GPS=false
CARTIQ_PRICE_FORECAST_ENABLED=false
CARTIQ_APPROVED_FORECAST_ENABLED=false
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
# Used only by the optional Firebase development overlay.
FIREBASE_DEV_ADC_FILE=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_VAPID_KEY=
