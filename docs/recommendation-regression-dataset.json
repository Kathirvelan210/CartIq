      "provenance": "Synthetic H2 fixture exercising the current canonical barcode registry",
      "suite": "com.smartcart.LiveOfferIntegrationTest",
      "test": "aBarcodeAssignedToADifferentVariantInvalidatesAnOtherwiseApprovedOffer"
    },
    {
